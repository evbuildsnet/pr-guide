{
  "name": "pr-guide",
  "version": "0.0.0",
  "description": "A guided tour of a pull request, written by your own Claude or Codex",
  "type": "module",
  "bin": {
    "pr-guide": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
