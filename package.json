    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evbuildsnet/pr-guide.git"
  }
}
